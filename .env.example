APP_NAME=Mentia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Español mexicano en toda la interfaz (Doc 08, definición de terminado).
# La zona horaria NO va aquí: se almacena en UTC y se presenta en la zona de
# cada organización. El porqué está en config/app.php.
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=es_MX
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8, InnoDB, utf8mb4. Doc 02 §1: cero JSON en datos de dominio.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mentia
DB_USERNAME=root
DB_PASSWORD=

# Base de pruebas: la crea tests/bootstrap.php si no existe.
DB_DATABASE_TESTING=mentia_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Colas en Redis: es lo que Horizon supervisa (Doc 02 §7).
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis no requiere extensión de PHP; en producción conviene phpredis.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PREFIX=mentia_horizon:
# HORIZON_DOMAIN=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@mentia.mx"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum: dominios que reciben cookie de sesión (SPA web). La app Flutter y
# los terceros usan tokens, no cookies.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# Redacción de reportes integradores (Fase 9). Sin llave, el módulo no opera.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5

VITE_APP_NAME="${APP_NAME}"
