{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mentia/plataforma",
    "type": "project",
    "description": "Mentia — plataforma SaaS multi-tenant de evaluación psicométrica longitudinal.",
    "keywords": ["mentia", "laravel", "saas", "psicometria", "multi-tenant"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.30",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "phpoffice/phpspreadsheet": "^5.9",
        "predis/predis": "^2.2",
        "spatie/laravel-activitylog": "^4.12 || ^5.0",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=servidor,colas,bitacora,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "pint": "vendor/bin/pint",
        "analiza": "vendor/bin/phpstan analyse --memory-limit=1G",
        "revisa": [
            "vendor/bin/pint --test",
            "vendor/bin/phpstan analyse --memory-limit=1G",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "ext-pcntl": "8.3.6",
            "ext-posix": "8.3.6"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
